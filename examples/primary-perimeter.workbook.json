  "units": [
    {
      "id": "U-PERIMETER",
      "title": {
        "zh": "长方形周长"
      },
      "scope": "core",
      "prerequisites": [],
      "refs": [
        {
          "source_id": "SRC-0ae3b7b67d21b773",
          "locator": "周长定义与母题段落"
        }
      ],
      "goal": {
        "zh": "能解释周长、求长方形周长，并区分完整周长和实际围栏长度。"
      },
      "intuition": {
        "zh": "用手指沿花坛四边走一圈，把四条边的长度加起来。"
      },
      "principles": {
        "zh": "对边分别相等，所以周长=长+宽+长+宽=(长+宽)×2。所有长度先统一单位。周长使用长度单位，面积使用面积单位。"
      },
      "demonstration": {
        "zh": "长2厘米、宽1厘米的小长方形，沿边数得2+1+2+1=6厘米；也可先算2+1再乘2。"
      },
      "method": [
        {
          "zh": "明确是求完整边界、实际用料还是未知边。"
        },
        {
          "zh": "画草图标已知信息，选择周长关系并计算。"
        },
        {
          "zh": "用四边相加、补回入口或代回周长核验。"
        }
      ],
      "pitfalls": [
        {
          "zh": "不把长乘宽当作周长。"
        },
        {
          "zh": "有入口时先算完整周长再扣除入口；同时核查入口是否重复扣除。"
        }
      ],
      "questions": [
        {
          "id": "U-PERIMETER-F1",
          "level": 1,
          "kind": "recognition",
          "role": "foundation",
          "origin": {
            "type": "original",
            "refs": []
          },
          "prompt": {
            "zh": "用自己的话解释长方形的周长。它和面积描述的是同一件事吗？"
          },
          "answer": {
            "steps": [
              {
                "zh": "周长是沿图形边界走一周的总长度。"
              },
              {
                "zh": "面积描述内部区域的大小，和边界总长度不同。"
              }
            ],
            "conclusion": {
              "zh": "周长是边界总长度，不是面积。"
            },
            "check": {
              "zh": "沿四条边描一圈，没有填满内部区域。"
            }
          },
          "assessment": {
            "status": "estimated",
            "audience": "已学长方形周长的小学四年级学习者；非课标认证",
            "ratings": {
