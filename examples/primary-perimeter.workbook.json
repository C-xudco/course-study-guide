          "prompt": {
            "zh": "长方形长4厘米、宽3厘米，求周长。"
          },
          "answer": {
            "steps": [
              {
                "zh": "相邻两条边长度之和为4+3=7厘米。"
              },
              {
                "zh": "两组这样的边合起来为7×2=14厘米。"
              }
            ],
            "conclusion": {
              "zh": "14厘米。"
            },
            "check": {
              "zh": "4+3+4+3=14厘米，与计算一致。"
            }
